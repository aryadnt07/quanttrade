# ==============================================================================
# QUANTTRADE — TELEGRAM NOTIFICATION CONFIGURATION TEMPLATE
# ==============================================================================
# Instruksi:
# 1. Salin (copy) file ini menjadi `.env` di folder root repositori.
# 2. Isi token dan chat ID Telegram Anda di bawah ini.
# 3. File `.env` sudah di-ignore oleh Git sehingga aman dari kebocoran ke GitHub.
# Catatan: Akun broker MT5 TIDAK membutuhkan kredensial di sini karena bot otomatis
# terhubung langsung ke terminal MetaTrader 5 yang sedang aktif di Windows/VPS.
# ==============================================================================

# Ubah TELEGRAM_ENABLED=true setelah Anda mengisi BOT_TOKEN dan CHAT_ID
TELEGRAM_ENABLED=false

# Token bot dari @BotFather (contoh: 123456789:ABCdefGhIJKlmNoPQRstuVWXyz)
TELEGRAM_BOT_TOKEN=

# ID Chat Telegram Anda dari @userinfobot (contoh: 123456789)
TELEGRAM_CHAT_ID=

# Pilihan Mode: "BALANCED" (Option A: Entry/Exit/Heartbeat/Alert), "ZEN" (Daily only), "OFF"
TELEGRAM_NOTIFY_MODE=BALANCED

# Jam UTC untuk pengiriman Daily System Heartbeat (0 = 00:00 UTC)
TELEGRAM_HEARTBEAT_UTC_HOUR=0

# false = Live Real Orders; true = Dry-run simulasi tanpa order riil
DRY_RUN=false
